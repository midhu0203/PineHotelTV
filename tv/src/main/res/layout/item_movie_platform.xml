<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/movie_platform_card"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/tile_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <TextView
        android:id="@+id/platform_icon"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/gold_accent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/platform_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="NETFLIX"
        android:textColor="@color/header_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/platform_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Movies &amp; Shows"
        android:textColor="@color/subtitle_text"
        android:textSize="9sp" />

</LinearLayout>