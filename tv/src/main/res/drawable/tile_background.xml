<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_bg" />

            <stroke
                android:width="2dp"
                android:color="@color/gold_accent" />

            <corners android:radius="9dp" />

        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="#3D192B" />

            <stroke
                android:width="2dp"
                android:color="@color/gold_accent" />

            <corners android:radius="9dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="#24121D" />

            <stroke
                android:width="1dp"
                android:color="#462334" />

            <corners android:radius="9dp" />

        </shape>
    </item>

</selector>